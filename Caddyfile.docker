# Caddyfile optimizado para Docker (hostnames internos de compose).
# Para despliegue bare-metal usa el Caddyfile raíz con localhost y paths absolutos.
:80 {
	encode gzip

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://connect.facebook.net; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://www.facebook.com; connect-src 'self' https://*.mercadopago.cl https://*.mercadopago.com https://www.facebook.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://*.mercadopago.com"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
	}

	handle /api/* {
		reverse_proxy backend:8080
	}
	handle /actuator/health {
		reverse_proxy backend:8080
	}

	# ── Micro-Frontends (Nuxt 3 SSR): ruteo por path a dos contenedores independientes ──
	# Rutas administrativas → contenedor 'frontend-panel' (Node SSR en :3000).
	@panel path /panel /panel/* /admin /admin/* /clientes /clientes/* /staff /staff/* /login /login/* /reset /reset/* /magic /magic/* /oauth2 /oauth2/*
	handle @panel {
		reverse_proxy frontend-panel:3000
	}

	# Todo lo demás (/, /:slug, /invitacion, /negocios, /privacidad, assets, _nuxt/) → app pública.
	handle {
		reverse_proxy frontend-public:3000
	}
}
