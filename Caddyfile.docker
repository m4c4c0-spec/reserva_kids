# Caddyfile optimizado para Docker (hostnames internos de compose).
# Para despliegue bare-metal usa el Caddyfile raíz con localhost y paths absolutos.
:80 {
	encode gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
	}
	# CSP lo gestiona nuxt-security (nonces por request) para las rutas SSR.
	# Solo lo seteamos acá para las rutas de API, que devuelven JSON.
	@api path /api/* /actuator/health
	header @api {
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
	}

	handle /api/* {
		reverse_proxy backend:8080
	}
	handle /actuator/health {
		reverse_proxy backend:8080
	}

	# ── Micro-Frontends (Nuxt 3 SSR): ruteo por path a dos contenedores independientes ──
	# Rutas administrativas → contenedor 'frontend-panel' (Node SSR en :3000).
	@panel path /panel /panel/* /admin /admin/* /clientes /clientes/* /staff /staff/* /negocios_duenos /negocios_duenos/* /reset /reset/* /magic /magic/* /oauth2 /oauth2/*
	handle @panel {
		reverse_proxy frontend-panel:3000
	}

	# Todo lo demás (/, /:slug, /invitacion, /negocios, /privacidad, assets, _nuxt/) → app pública.
	handle {
		reverse_proxy frontend-public:3000
	}
}
