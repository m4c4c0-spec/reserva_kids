# Base de la API. En dev Vite se usa '' (proxy de Vite → /api relativo).
# En producción setear el dominio público (ej. https://api.tudominio.cl).
VITE_API_URL=

# Slug del negocio en modo Licencia Exclusiva (Single-Tenant).
# Vacío = marketplace multi-tenant normal.
# En Vite dev se lee de acá. En Docker el entrypoint.sh lo inyecta en index.html.
# VITE_SINGLE_TENANT_SLUG=fiestas-globito
