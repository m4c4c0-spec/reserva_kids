# ── ReservaKids — Caddyfile para el host (producción) ──
# Sustituye TU_DOMINIO por tu dominio real antes de copiar a /etc/caddy/Caddyfile:
#   sed "s/TU_DOMINIO/reservakids.cl/g" Caddyfile | sudo tee /etc/caddy/Caddyfile

TU_DOMINIO {
    encode gzip

    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        X-Frame-Options "DENY"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        # HSTS: 30 días para primer deploy. Tras validar HTTPS estable: subir a 1 año.
        # No uses "preload" hasta que el dominio esté registrado en hstspreload.org.
        Strict-Transport-Security "max-age=2592000; includeSubDomains"
    }
    # CSP lo gestiona nuxt-security (nonces por request) para las rutas SSR.
    # Solo lo seteamos acá para las rutas de API, que devuelven JSON.
    @api path /api/* /actuator/health
    header @api {
        Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
    }

    handle /api/* {
        reverse_proxy localhost:8080
    }
    handle /actuator/health {
        reverse_proxy localhost:8080
    }

    # ── Micro-Frontends (Nuxt 3 SSR): ruteo por path a dos procesos independientes ──
    # Panel del Dueño, admin, área de cliente, staff y auth → proceso en :3001
    @panel path /panel /panel/* /admin /admin/* /clientes /clientes/* /staff /staff/* /negocios_duenos /negocios_duenos/* /reset /reset/* /magic /magic/* /oauth2 /oauth2/*
    handle @panel {
        reverse_proxy localhost:3001
    }

    # App pública (/, /:slug, /invitacion, /negocios, /privacidad, assets) → :3000
    handle {
        reverse_proxy localhost:3000
    }
}

www.TU_DOMINIO {
    redir https://TU_DOMINIO{uri} permanent
}
