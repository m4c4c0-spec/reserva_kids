# ── ReservaKids — variables de entorno (copiar a .env, sin secretos reales en el repo) ──

# ════════════════════════════════════════════════════════════════
#  PRODUCCIÓN (VPS con Caddy en el host + Docker)
#  deploy-prod.sh usa estas vars para configurar Caddy y las URLs
# ════════════════════════════════════════════════════════════════
# Dominio público del cliente (sin https://). Caddy auto-provisiona HTTPS.
DOMAIN=reservas.tudominio.cl

# En prod estas tres van con https://DOMAIN — deploy-prod.sh las setea solo
# si las dejaste en localhost, pero es mejor ponerlas a mano:
FRONTEND_URL=https://reservas.tudominio.cl
CORS_ALLOWED_ORIGINS=https://reservas.tudominio.cl
API_URL=https://reservas.tudominio.cl

# ── Auto-Instalador Single-Tenant (Licencia Exclusiva) ──
# Al arrancar el backend con BD vacía, crea automáticamente este negocio + dueño.
# El slug debe coincidir con VITE_SINGLE_TENANT_SLUG del frontend.
# Multi-tenant (SaaS/directorio): dejar ENABLED=false y vacío el resto.
RESERVAKIDS_SINGLE_TENANT_ENABLED=true
RESERVAKIDS_SINGLE_TENANT_SLUG=dulce-vida
RESERVAKIDS_SINGLE_TENANT_NOMBRE="Dulce Vida"
RESERVAKIDS_SINGLE_TENANT_ADMIN_EMAIL=admin@dulcevida.cl
RESERVAKIDS_SINGLE_TENANT_ADMIN_PASSWORD=cambiar-clave-inicial

# Frontend (vacío = la API se sirve en el mismo dominio vía /api/* en Caddy)
VITE_API_URL=

# ════════════════════════════════════════════════════════════════
#  Secrets (CAMBIAR todos en producción)
# ════════════════════════════════════════════════════════════════

# PostgreSQL
POSTGRES_DB=reservakids
POSTGRES_USER=reservakids_app
POSTGRES_PASSWORD=cambiar-en-produccion

# Backend
DB_URL=jdbc:postgresql://localhost:5432/reservakids
DB_USER=reservakids_app
DB_PASSWORD=cambiar-en-produccion

# JWT — generar con: openssl rand -base64 64
JWT_SECRET=cambiar-por-secreto-de-64-bytes-minimo

# S1: clave AES-256 (base64 de 32 bytes) para cifrar credenciales de Mercado Pago en reposo.
# Vacía = se deriva de JWT_SECRET (ok en dev). En producción: openssl rand -base64 32
CRED_ENC_KEY=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Refresh token en cookie HttpOnly. Secure=true exige HTTPS (producción);
# en dev (HTTP) debe ser false o el navegador descarta la cookie.
# compose.prod.yml fuerza COOKIE_SECURE=true, así que aquí podés dejarlo false para dev.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# Falla 1.3 (revisión 5 años): base de los enlaces de reset de contraseña + vigencia
RESET_PASSWORD_MINUTOS=30

# Expiración de solicitudes pendientes (criterio RF-05)
RESERVA_EXPIRACION_HORAS=48

# Falla #1 (revisión 2 años): cotizaciones sin respuesta liberan su bloque tras N días
COTIZACION_EXPIRACION_DIAS=14

# Cita por hora sin pagar: minutos que retiene la franja antes de liberarla
CITA_PAGO_EXPIRACION_MIN=30

# Notificaciones por WhatsApp (Meta Cloud API).
# false = stub (solo log); true = envía vía Meta WhatsApp Cloud API v22.0.
# Para obtener PHONE_ID y TOKEN: Meta Business Suite > WhatsApp > API Setup.
# IMPORTANTE: el TOKEN debe ser un User Access Token (empieza con EAA...),
# NO un App Token (APP_ID|APP_SECRET). Generar en:
#   https://developers.facebook.com/tools/explorer/ → WhatsApp Business Management API
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=

# Falla #4 (revisión 2 años, Ley 21.719): meses de inactividad antes de anonimizar al cliente
RETENCION_CLIENTE_MESES=24

# Falla 3.3 (revisión 5 años): días entre el cierre de un negocio y su purga física
TENANT_PURGA_DIAS=90

# Falla #7 (revisión 2 años): copia offsite de backups — remoto rclone ya configurado
# (rclone config → Backblaze B2/S3). Vacío = solo backup local.
# RCLONE_REMOTE=b2:reservakids-backups

# Zona horaria del negocio (el servidor corre en UTC)
APP_TIMEZONE=America/Santiago

# true SOLO detrás de un reverse proxy (Caddy/nginx) que setee X-Forwarded-For
# compose.prod.yml fuerza TRUST_PROXY=true en prod.
TRUST_PROXY=false

# ── Email transaccional (RF-08 + reset de contraseña) ──
# Vacío + docker compose = Mailpit local: los correos se capturan en http://localhost:8025
# (nada sale a internet). Backend corriendo fuera de docker: MAIL_HOST=localhost MAIL_PORT=1025.
# Proveedor real (producción), p. ej. Resend (capa gratis 3000 emails/mes):
#   MAIL_HOST=smtp.resend.com
#   MAIL_PORT=587
#   MAIL_USERNAME=resend
#   MAIL_PASSWORD=re_xxxxx (API Key de https://resend.com/api-keys)
#   MAIL_SMTP_AUTH=true  MAIL_SMTP_STARTTLS=true
#   MAIL_FROM=onboarding@resend.dev (testing) o no-reply@tudominio.cl (producción)
# Para producción con Resend: verifica tu dominio en https://resend.com/domains
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=
MAIL_SMTP_STARTTLS=
MAIL_FROM=no-reply@tudominio.cl

# ── Admin de plataforma (dev/bootstrap) ──
# Vacíos = no se crea ningún admin de plataforma (solo el del negocio vía single-tenant).
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NOMBRE=Administrador

# Rate limiting por IP (req/minuto). Ajustar si hay spikes legítimos.
# RATE_LIMIT_PUBLIC=30
# RATE_LIMIT_AUTH=10
# RATE_LIMIT_CLIENTE_AUTH=10
# RATE_LIMIT_ADMIN_AUTH=5
# RATE_LIMIT_PANEL=60
# RATE_LIMIT_WEBHOOK=5

# Anti-replay del webhook de Mercado Pago (minutos de validez de la firma)
# MP_WEBHOOK_SIG_MAX_AGE_MINUTES=5

# V25: Khipu (transferencias bancarias directas, alternativa a Mercado Pago).
# Base de la API (igual en dev y prod); cada dueño carga su propia API key en el panel.
# KHIPU_API_BASE=https://api.khipu.com
# Anti-replay del webhook de Khipu (minutos de validez de la firma)
# KHIPU_WEBHOOK_SIG_MAX_AGE_MINUTES=5

# V27: magic link de login sin contraseña (dueños adultos mayores). Plazo de validez
# corto (10 min) y single-use; reutiliza la misma tabla de reset de contraseña.
# MAGIC_LINK_MINUTOS=10

# ── OAuth2 / SSO (Google, Microsoft, Apple) ──
# Cada proveedor se activa independientemente al setear su client-id + secret.
# IMPORTANTE: en Google Cloud Console, authorized redirect URI =
#   https://TU_DOMINIO/oauth2/callback
# Google: https://console.cloud.google.com/apis/credentials
OAUTH2_GOOGLE_CLIENT_ID=
OAUTH2_GOOGLE_CLIENT_SECRET=
# Microsoft: https://portal.azure.com → App registrations
# OAUTH2_MICROSOFT_CLIENT_ID=
# OAUTH2_MICROSOFT_CLIENT_SECRET=
# Apple: https://developer.apple.com → Sign in with Apple
# OAUTH2_APPLE_CLIENT_ID=
# OAUTH2_APPLE_TEAM_ID=
# OAUTH2_APPLE_KEY_ID=
# OAUTH2_APPLE_PRIVATE_KEY=

# ── Alertas proactivas a Operaciones (Slack) ──
# Webhook URL de Slack Incoming Webhook. Vacío = stub que loguea en WARN.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...
# Umbral de fallos consecutivos de webhook de pago antes de disparar la alerta.
# ALERTAS_WEBHOOK_UMBRAL=3

# ── Observabilidad: Tracing distribuido (OpenTelemetry) ──
# Endpoint OTLP para enviar trazas. En Docker usa http://otel-collector:4318/v1/traces
# OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# Sampling rate (1.0 = 100% en dev, 0.1 = 10% en prod)
# TRACING_SAMPLE_RATE=1.0
# Contraseña del admin de Grafana en PROD (compose.prod.yml desactiva el acceso anónimo).
# deploy-prod.sh la autogenera si queda vacía. Grafana queda en 127.0.0.1: acceso por túnel SSH.
GRAFANA_ADMIN_PASSWORD=
